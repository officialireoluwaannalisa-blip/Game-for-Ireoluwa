# ─── Server-side environment ────────────────────────────────────────────────
# Server-side Hydrogen / Gemini API key secret (required for AI building).
# The app works without it on the static build, and single-feature without it on the live server.
GEMINI_API_KEY=

# Port the Node server listens on (default 3000)
PORT=3000

# Where the shared island world is persisted (default ./data/world-state.json).
# In production point this at a persistent volume, e.g. /var/data/ireoluwa/world-state.json
WORLD_STATE_PATH=./data/world-state.json
