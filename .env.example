# ─── Server-side environment ────────────────────────────────────────────────
# Server-side Hydrogen / Gemini API key secret (required for AI building).
# The app works without it on the static build, and single-feature without it on the live server.
GEMINI_API_KEY=

# Port the Node server listens on (default 3000)
PORT=3000

# Where the shared island world is persisted (default ./data/world-state.json).
# In production point this at a persistent volume, e.g. /var/data/ireoluwa/world-state.json
WORLD_STATE_PATH=./data/world-state.json

# ─── Island Deeds (Stripe card payments for the 20 unlockable islands) ─────
# Secret key from https://dashboard.stripe.com/apikeys — set on Vercel only.
STRIPE_SECRET_KEY=
# Signing "Island Deeds" separately from Stripe avoids coupling; falls back to
# STRIPE_WEBHOOK_SECRET, then STRIPE_SECRET_KEY when unset. Use any random
# 32+ byte string, e.g. `openssl rand -hex 32`.
ISLAND_DEED_SECRET=
# DEVELOPMENT-ONLY: set to 1 to make the store fulfill purchases locally
# without Stripe (no card is charged). NEVER set this on production.
ISLAND_DEEDS_TEST_MODE=
